{
    "name": "fntv-mpv",
    "version": "1.0.0",
    "description": "MPV播放器和插件管理工具",
    "config": {
        "output_dir": "../fntv-electron/third_party",
        "temp_dir": "./temp",
        "custom_config_dir": "./custom_config",
        "github_proxy": "https://ghfast.top",
        "enable_proxy": false
    },
    "dependencies": {
        "mpv": {
            "name": "mpv播放器",
            "enabled": true,
            "url": "https://github.com/shinchiro/mpv-winbuild-cmake/releases",
            "version": "20250915",
            "filename_pattern": "mpv-x86_64-{version}",
            "format": "7z",
            "exclude_files": [
                "doc/*",
                "installer/*",
                "*.bat",
                "*.md",
                "LICENSE*"
            ]
        },
        "uosc": {
            "name": "uosc插件",
            "enabled": true,
            "url": "https://github.com/tomasklaen/uosc/releases",
            "version": "5.11.0",
            "filename_pattern": "uosc",
            "format": "zip",
            "exclude_files": [
                "*.md",
                "LICENSE*"
            ],
            "custom_install_rules": [
                {
                    "from": "scripts",
                    "to": "portable_config/scripts",
                    "filter": ["**/*"]
                },
                {
                    "from": "fonts",
                    "to": "portable_config/fonts",
                    "filter": ["**/*"]
                }
            ]
        },
        "uosc_danmaku": {
            "name": "uosc弹幕插件",
            "enabled": true,
            "url": "https://github.com/Tony15246/uosc_danmaku/releases",
            "version": "v2.0.0",
            "filename_pattern": "uosc_danmaku",
            "format": "zip",
            "exclude_files": [
                "*.md",
                "LICENSE*"
            ]
        }
    }
}