{
    "name": "fntv-mpv-config",
    "version": "1.0.0",
    "description": "MPV播放器和插件管理工具",
    "config": {
        "output_dir": "./output",
        "temp_dir": "./temp",
        "custom_config_dir": "./custom_config",
        "github_proxy": "https://ghfast.top",
        "enable_proxy": true
    },
    "dependencies": {
        "mpv": {
            "name": "mpv播放器",
            "enabled": true,
            "url": "https://github.com/shinchiro/mpv-winbuild-cmake/releases",
            "version": "20250823",
            "filename_pattern": "mpv-dev-x86_64-{version}",
            "format": "7z",
            "install_rules": [
                {
                    "from": "",
                    "to": "",
                    "filter": [
                        "mpv.exe",
                        "mpv.com"
                    ]
                },
                {
                    "from": "doc",
                    "to": "doc",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "uosc": {
            "name": "uosc插件",
            "enabled": true,
            "url": "https://github.com/tomasklaen/uosc/releases",
            "version": "5.11.0",
            "filename_pattern": "uosc",
            "format": "zip",
            "install_rules": [
                {
                    "from": "scripts",
                    "to": "scripts",
                    "filter": [
                        "**/*.lua"
                    ]
                },
                {
                    "from": "fonts",
                    "to": "fonts",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "uosc_danmaku": {
            "name": "uosc弹幕插件",
            "enabled": true,
            "url": "https://github.com/Tony15246/uosc_danmaku/releases",
            "version": "v1.3.2",
            "filename_pattern": "uosc_danmaku",
            "format": "zip",
            "install_rules": [
                {
                    "from": "scripts",
                    "to": "scripts",
                    "filter": [
                        "**/*.lua"
                    ]
                }
            ]
        }
    }
}